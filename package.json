{
  "name": "@vx-foundation/vx",
  "version": "0.1.3",
  "description": "Compiler-first full-stack web framework with direct DOM rendering, deterministic SSR, typed data primitives, and production deployment adapters.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "verify:policy": "pnpm verify:package-manager && node scripts/verify-repository-policy.mjs",
    "verify": "pnpm verify:policy && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:package-layout",
    "verify:framework": "node scripts/verify-framework.mjs",
    "verify:documentation": "pnpm docs:api && pnpm --filter @vx-foundation/docs typecheck",
    "verify:official-apps": "pnpm --filter \"./apps/official-*\" typecheck && node scripts/verify-phase21.mjs && node scripts/verify-phase21-runtime.mjs",
    "verify:official-apps:ci": "pnpm --filter \"./apps/official-*\" verify",
    "verify:stabilization": "node scripts/verify-phase22.mjs && node scripts/release/verify-v1-readiness.mjs --channel next",
    "verify:conformance": "pnpm verify:framework && pnpm verify:documentation && pnpm verify:official-apps && pnpm verify:stabilization",
    "verify:quality": "pnpm security:verify && pnpm fuzz:continuous && pnpm bench:quality && pnpm bench:public:verify",
    "verify:project-creation": "node scripts/release/verify-project-creation.mjs",
    "verify:release-candidate": "pnpm verify && pnpm verify:conformance && pnpm verify:quality && pnpm verify:project-creation && pnpm release:artifacts && pnpm release:clean-room && pnpm release:clean-room-projects && pnpm release:unstable:check",
    "verify:package-layout": "node scripts/verify-package-layout.mjs",
    "verify:package-manager": "node scripts/test-package-manager-config.mjs && node scripts/verify-package-manager-config.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:browser": "pnpm --filter @vx-foundation/tests test:e2e",
    "test:security": "turbo run test:security",
    "test:fuzz": "turbo run test:fuzz",
    "test:official": "pnpm --filter @vx-foundation/testing test && pnpm --filter @vx-foundation/tests test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:vx": "node packages/cli/dist/cli.js format .",
    "format:vx:check": "node packages/cli/dist/cli.js format . --check",
    "security:verify": "node scripts/security/phase20-security.mjs",
    "fuzz:continuous": "node scripts/fuzz/phase20-fuzz.mjs",
    "bench": "turbo run bench",
    "bench:quality": "node scripts/benchmark/phase20-quality-benchmark.mjs",
    "bench:public": "node benchmarks/public/scripts/run.mjs --framework all --scenario all",
    "bench:public:verify": "node scripts/benchmark/verify-public-benchmark.mjs",
    "docs:api": "node scripts/docs/generate-api-reference.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "release:check": "node packages/cli/dist/cli.js release:check . --channel stable",
    "release:snapshot": "node packages/cli/dist/cli.js release:snapshot . --out release/public-api.json",
    "release:artifacts": "node scripts/release/verify-package-artifacts.mjs",
    "release:provenance": "node scripts/release/create-provenance.mjs .",
    "release:clean-room": "node scripts/release/clean-room-install.mjs",
    "release:clean-room-projects": "node scripts/release/clean-room-projects.mjs",
    "release:unstable:check": "node packages/cli/dist/cli.js release:check . --channel next",
    "release:repository-check": "node scripts/release/verify-repository.mjs",
    "release:npm-preflight": "node scripts/release/npm-preflight.mjs",
    "release:github-checks": "node scripts/release/verify-github-checks.mjs",
    "release:canary:prepare": "node scripts/release/prepare-channel-version.mjs --channel canary",
    "release:next:prepare": "node scripts/release/prepare-channel-version.mjs --channel next",
    "release:sync-version": "node scripts/release/sync-version.mjs",
    "release:stable:check": "node scripts/release/verify-v1-readiness.mjs --channel stable && node packages/cli/dist/cli.js release:check . --channel stable --baseline release/api-baseline.json",
    "release:source-check": "node scripts/release/verify-source-tree.mjs",
    "freeze:update": "node scripts/release/create-freeze-manifests.mjs",
    "repository:init": "node scripts/release/initialize-git.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "eslint": "^9.31.0",
    "globals": "^17.8.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vx-foundation/core": "workspace:*"
  },
  "author": {
    "name": "Veelv"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git"
  },
  "homepage": "https://github.com/VX-Foundation/vx#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vx",
    "web-framework",
    "compiler",
    "typescript",
    "ssr",
    "hydration",
    "full-stack"
  ],
  "overrides": {
    "dompurify": "^3.4.12",
    "monaco-editor": {
      "dompurify": "^3.4.12"
    },
    "brace-expansion": "^2.1.4",
    "minimatch": "^9.0.5",
    "semver": "^7.6.3",
    "axios": "^1.7.9",
    "undici": "^6.21.1",
    "micromatch": "^4.0.8",
    "glob-parent": "^6.0.2",
    "word-wrap": "^1.2.5",
    "cross-spawn": "^7.0.6",
    "qs": "^6.13.0",
    "cookie": "^0.7.2",
    "tar": "^7.4.3",
    "json5": "^2.2.3",
    "follow-redirects": "^1.15.9",
    "postcss": "^8.4.49",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
