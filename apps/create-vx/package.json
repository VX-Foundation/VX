{
  "name": "@vx-foundation/create-vx",
  "version": "0.1.2",
  "description": "Scaffolding tool for VX framework",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "create-vx": "./bin/create-vx.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vx-foundation/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "Veelv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git",
    "directory": "apps/create-vx"
  },
  "homepage": "https://github.com/VX-Foundation/vx/tree/main/apps/create-vx#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "keywords": [
    "vx",
    "web-framework",
    "typescript",
    "cli"
  ]
