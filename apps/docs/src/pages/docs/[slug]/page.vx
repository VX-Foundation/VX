#script
  prop slug: String
#end script

#view
  View @page {
    Link("Back to documentation") { href: "/" }
    Text("Documentation / " + slug)
    Title("VX documentation")
    Text("This route is generated from the repository documentation manifest.")
    Text("Use the source document for normative details and complete examples.")
  }

  @page { flow: vertical space: lg inset: xl maxWidth: 960 }
#end view
