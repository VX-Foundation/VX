#view
  View @page {
    Text("PACKAGE REFERENCE") @eyebrow
    Title("@vx-foundation/package-system")
    Text("Deterministic package metadata, lockfiles, workspaces, integrity, signatures, and dependency mutation for VX.") @lead
    View @section {
      Title("Package contract") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Field") @propertyName
          Text("Value") @propertyDescription
        }
        View @tableRow {
          Text("Package") @propertyName
          Text("@vx-foundation/package-system") @propertyDescription
        }
        View @tableRow {
          Text("Version") @propertyName
          Text("0.2.0") @propertyDescription
        }
        View @tableRow {
          Text("Source") @propertyName
          Text("packages/package-system") @propertyDescription
        }
        View @tableRow {
          Text("Subpath exports") @propertyName
          Text("., ./contracts, ./exports, ./integrity, ./lockfile, ./metadata, ./publication, ./semver, ./signatures, ./workspace") @propertyDescription
        }
        View @tableRow {
          Text("Stability") @propertyName
          Text("follows the unified VX 0.2.0 release line") @propertyDescription
        }
      }
    }
    View @section {
      Title("Installation") { level: 2 }
      View @codeBlock {
        Text("pnpm add @vx-foundation/package-system@next")
      }
    }
