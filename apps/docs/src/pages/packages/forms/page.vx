#view
  View @page {
    Text("PACKAGE REFERENCE") @eyebrow
    Title("@vx-foundation/forms")
    Text("Typed VX forms, schema validation, progressive enhancement, and multipart handling.") @lead
    View @section {
      Title("Package contract") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Field") @propertyName
          Text("Value") @propertyDescription
        }
        View @tableRow {
          Text("Package") @propertyName
          Text("@vx-foundation/forms") @propertyDescription
        }
        View @tableRow {
          Text("Version") @propertyName
          Text("0.2.0") @propertyDescription
        }
        View @tableRow {
          Text("Source") @propertyName
          Text("packages/forms") @propertyDescription
        }
        View @tableRow {
          Text("Subpath exports") @propertyName
          Text("., ./client, ./server") @propertyDescription
        }
        View @tableRow {
          Text("Stability") @propertyName
          Text("follows the unified VX 0.2.0 release line") @propertyDescription
        }
      }
    }
    View @section {
      Title("Installation") { level: 2 }
      View @codeBlock {
        Text("pnpm add @vx-foundation/forms@next")
      }
    }
    View @section {
      Title("Public entry points") { level: 2 }
      View @chipRow {
        Text(".") @chip
        Text("./client") @chip
        Text("./server") @chip
      }
    }
