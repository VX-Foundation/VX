#view
  View @page {
    Text("PACKAGE REFERENCE") @eyebrow
    Title("@vx-foundation/release")
    Text("Public API compatibility, package policy, release channels, and provenance tooling for VX.") @lead
    View @section {
      Title("Package contract") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Field") @propertyName
          Text("Value") @propertyDescription
        }
        View @tableRow {
          Text("Package") @propertyName
          Text("@vx-foundation/release") @propertyDescription
        }
        View @tableRow {
          Text("Version") @propertyName
          Text("0.2.0") @propertyDescription
        }
        View @tableRow {
          Text("Source") @propertyName
          Text("packages/release") @propertyDescription
        }
        View @tableRow {
          Text("Subpath exports") @propertyName
          Text("., ./snapshot, ./compatibility, ./policy, ./provenance") @propertyDescription
        }
        View @tableRow {
          Text("Stability") @propertyName
          Text("follows the unified VX 0.2.0 release line") @propertyDescription
        }
      }
    }
    View @section {
      Title("Installation") { level: 2 }
      View @codeBlock {
        Text("pnpm add @vx-foundation/release@next")
      }
    }
    View @section {
      Title("Public entry points") { level: 2 }
      View @chipRow {
        Text(".") @chip
        Text("./snapshot") @chip
        Text("./compatibility") @chip
        Text("./policy") @chip
        Text("./provenance") @chip
      }
    }
    View @section {
      Title("Overview") { level: 2 }
      Text("Public API compatibility, package policy, release channels, and provenance tooling for VX.")
      Text("Current package line: 0.2.0.")
    }
    View @section {
      Title("Public entries") { level: 2 }
      View @list {
        Text("• . -> ./dist/index.d.ts") @bullet
        Text("• ./compatibility -> ./dist/compatibility.d.ts") @bullet
        Text("• ./policy -> ./dist/policy.d.ts") @bullet
        Text("• ./provenance -> ./dist/provenance.d.ts") @bullet
        Text("• ./snapshot -> ./dist/snapshot.d.ts") @bullet
      }
    }
    View @section {
      Title("Exported symbols") { level: 2 }
      View @list {
        Text("• collectPublicSymbols - function in snapshot.ts") @bullet
        Text("• compareApiSnapshots - function in compatibility.ts") @bullet
        Text("• CompatibilityChange - interface in types.ts") @bullet
        Text("• CompatibilityReport - interface in types.ts") @bullet
        Text("• createProvenanceManifest - function in provenance.ts") @bullet
        Text("• createReleaseChannelPlan - function in channels.ts") @bullet
        Text("• CreateReleasePlanOptions - interface in channels.ts") @bullet
        Text("• createWorkspaceApiSnapshot - function in snapshot.ts") @bullet
        Text("• CreateWorkspaceSnapshotOptions - interface in snapshot.ts") @bullet
        Text("• impactRank - function in semver.ts") @bullet
        Text("• maximumImpact - function in semver.ts") @bullet
        Text("• PackageCompatibilityResult - interface in types.ts") @bullet
        Text("• PackagePolicyIssue - interface in types.ts") @bullet
        Text("• PackagePolicyOptions - interface in policy.ts") @bullet
        Text("• PackagePolicyResult - interface in types.ts") @bullet
        Text("• ParsedVersion - interface in semver.ts") @bullet
        Text("• parseVersion - function in semver.ts") @bullet
        Text("• ProvenanceFile - interface in types.ts") @bullet
        Text("• ProvenanceInputFile - interface in provenance.ts") @bullet
        Text("• ProvenanceManifest - interface in types.ts") @bullet
        Text("• PublicEntrypointSnapshot - interface in types.ts") @bullet
        Text("• PublicPackageSnapshot - interface in types.ts") @bullet
        Text("• PublicSymbolSnapshot - interface in types.ts") @bullet
        Text("• ReleaseChannel - type in types.ts") @bullet
        Text("• ReleaseChannelPlan - interface in types.ts") @bullet
        Text("• SemverImpact - type in types.ts") @bullet
        Text("• snapshotPackage - function in snapshot.ts") @bullet
        Text("• validatePackagePolicy - function in policy.ts") @bullet
        Text("• verifyProvenanceManifest - function in provenance.ts") @bullet
        Text("• versionImpact - function in semver.ts") @bullet
        Text("• WorkspaceApiSnapshot - interface in types.ts") @bullet
      }
    }
    View @section {
      Title("Stability") { level: 2 }
      Text("Only entries listed above are public. Imports from src, dist, or undeclared files are unsupported and rejected by the official-application gate.")
    }
    View @section {
      Title("Usage policy") { level: 2 }
      View @list {
        Text("• Import only documented root or subpath exports; internal source paths are not compatibility contracts.") @bullet
        Text("• Keep package versions aligned with release/version.json and the fixed Changesets group.") @bullet
        Text("• Test browser, server, edge, and Node boundaries only where the package declares support.") @bullet
        Text("• Treat generated API snapshots and freeze manifests as release gates, not documentation suggestions.") @bullet
      }
    }
  }

  @page { flow: vertical gap: xl inset: hero maxWidth: 1120 marginX: auto width: fill }
  @eyebrow { typography: label.sm color: sapphire-600 }
  @lead { typography: body.xl color: cloud-600 maxWidth: prose }
  @section { flow: vertical gap: md }
  @subsection { flow: vertical gap: sm }
  @codeBlock { flow: vertical gap: xs typography: mono.md surface: code color: cloud-100 corner: lg inset: lg overflow: auto }
  @table { flow: vertical gap: none border: subtle corner: lg overflow: hidden }
  @tableHeader { flow: horizontal gap: md inset: md surface: sapphire-50 typography: label.sm color: sapphire-900 }
  @tableRow { flow: horizontal gap: md inset: md borderTop: subtle typography: body.sm }
  @propertyName { typography: mono.sm color: sapphire-700 minWidth: 14rem }
  @propertyValue { typography: mono.sm color: cloud-700 minWidth: 12rem }
  @propertyDescription { typography: body.sm color: cloud-600 width: fill }
  @list { flow: vertical gap: sm }
  @bullet { typography: body.md color: cloud-700 }
  @callout { flow: vertical gap: sm inset: lg surface: sapphire-50 border: sapphire-200 corner: lg }
  @cards { flow: grid columns: 2 minColumn: 260 gap: md }
  @card { flow: vertical gap: sm inset: lg surface: raised border: subtle corner: lg }
  @cardTitle { typography: heading.md color: sapphire-700 }
  @meta { typography: body.sm color: cloud-500 }
  @chipRow { flow: horizontal gap: sm wrap: true }
  @chip { typography: mono.sm surface: sapphire-50 color: sapphire-800 border: sapphire-200 corner: pill inset: badge }
#end view
