#view
  View @page {
    Text("PACKAGE REFERENCE") @eyebrow
    Title("@vx-foundation/data")
    Text("VX query persistence, offline mutations, infinite data, realtime subscriptions, and cross-context synchronization.") @lead
    View @section {
      Title("Package contract") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Field") @propertyName
          Text("Value") @propertyDescription
        }
        View @tableRow {
          Text("Package") @propertyName
          Text("@vx-foundation/data") @propertyDescription
        }
        View @tableRow {
          Text("Version") @propertyName
          Text("0.2.0") @propertyDescription
        }
        View @tableRow {
          Text("Source") @propertyName
          Text("packages/data") @propertyDescription
        }
        View @tableRow {
          Text("Subpath exports") @propertyName
          Text("., ./persistence, ./offline, ./infinite, ./realtime, ./broadcast, ./hub") @propertyDescription
        }
        View @tableRow {
          Text("Stability") @propertyName
          Text("follows the unified VX 0.2.0 release line") @propertyDescription
        }
      }
    }
    View @section {
      Title("Installation") { level: 2 }
      View @codeBlock {
        Text("pnpm add @vx-foundation/data@next")
