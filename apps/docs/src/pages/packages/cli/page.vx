    View @section {
      Title("Usage policy") { level: 2 }
      View @list {
        Text("• Import only documented root or subpath exports; internal source paths are not compatibility contracts.") @bullet
        Text("• Keep package versions aligned with release/version.json and the fixed Changesets group.") @bullet
        Text("• Test browser, server, edge, and Node boundaries only where the package declares support.") @bullet
        Text("• Treat generated API snapshots and freeze manifests as release gates, not documentation suggestions.") @bullet
