#view
  View @page {
    Text("VISUAL REFERENCE") @eyebrow
    Title("Visual properties")
    Text("167 supported properties. Unknown names and unsafe values produce diagnostics instead of silent CSS drift.") @lead
    View @section {
      Title("Property groups") { level: 2 }
      View @cards {
        View @card {
          Link("Layout - flex") @cardTitle { href: "/visual/properties/category/layout-flex" }
          Text("13 properties.") @meta
        }
        View @card {
          Link("Layout - grid") @cardTitle { href: "/visual/properties/category/layout-grid" }
          Text("11 properties.") @meta
