#view
  View @page {
    Text("PROJECT AND POLICY") @eyebrow
    Title("VX Framework: Native Industrial Color Palette System")
    Text("The VX Framework provides a built-in, industrial-grade color palette system (VX_COLOR_PALETTES) with curated 50-950 shade scales and semantic design tokens for rapid, accessible, and high-performance UI styling.") @lead
    View @section {
      Title("Overview") { level: 2 }
      Text("The VX Framework provides a built-in, industrial-grade color palette system (VX_COLOR_PALETTES) with curated 50-950 shade scales and semantic design tokens for rapid, accessible, and high-performance UI styling.")
    }
    View @section {
      Title("🎨 Color Families Overview") { level: 2 }
      Title("1. Grayscale & Neutral Palettes (Shades 50–950)") { level: 3 }
      View @list {
        Text("• cloud: Cool, crisp slate-tinted gray (#fafcfd to #070912).") @bullet
        Text("• smoke: Balanced, neutral gray (#fbfbfc to #090c11).") @bullet
        Text("• steel: Industrial metallic steel (#fcfcfc to #0b0c0f).") @bullet
        Text("• charcoal: Warm graphite charcoal (#fbfbf9 to #0e0c0a).") @bullet
        Text("• rock: Deep earthy stone (#fbfaf8 to #0f0d0a).") @bullet
      }
      Title("2. Vibrant & Semantic Palettes (Shades 50–950)") { level: 3 }
      View @list {
        Text("• Reds & Pinks: cherry, ruby, rose, blossom") @bullet
        Text("• Oranges & Yellows: coral, sunset, lemon") @bullet
        Text("• Greens & Teals: mint, forest, emerald, turquoise") @bullet
        Text("• Blues & Purples: sky, ocean, sapphire, lavender, plum, violet") @bullet
      }
      Title("3. Special Colors") { level: 3 }
      View @list {
        Text("• white (#ffffff), black (#000000), transparent, current (currentColor).") @bullet
      }
    }
    View @section {
      Title("💻 Usage in .vx Single-File Components") { level: 2 }
      Text("Native color tokens can be referenced directly by name and shade in visual roles (@role):")
      View @codeBlock {
        Text("#view")
        Text("  Button(\"Confirm Action\") @primaryButton")
        Text("  View @card {")
        Text("    Text(\"Server Active\") @statusBadge")
        Text("  }")
        Text(" ")
        Text("  @primaryButton {")
        Text("    surface: cherry-600")
        Text("    tone: cloud-50")
        Text("    corner: md")
        Text("    when hover {")
        Text("      surface: cherry-500")
        Text("    }")
        Text("  }")
        Text(" ")
        Text("  @card {")
        Text("    surface: steel-900")
        Text("    border: steel-800")
        Text("    tone: cloud-100")
        Text("    inset: xl")
        Text("  }")
        Text(" ")
        Text("  @statusBadge {")
        Text("    surface: emerald-100")
        Text("    tone: emerald-900")
        Text("    inset: badge")
        Text("    corner: pill")
        Text("  }")
        Text("#end view")
      }
    }
    View @section {
      Title("🛠️ Color Token Resolution") { level: 2 }
      Text("When the VX Visual Compiler compiles properties like surface, color, border, or gradient:")
      View @list {
        Text("• Named Token Match: cherry-600 is compiled directly into #e22631.") @bullet
        Text("• Shade Fallback: If no shade is specified (e.g. surface: sapphire), shade 500 (#3c82f7) is applied by default.") @bullet
        Text("• Hex & CSS Value Fallback: Arbitrary Hex (#2563eb), RGB/HSL, and CSS var(--...) custom properties remain fully supported.") @bullet
      }
    }
  }

  @page { flow: vertical gap: xl inset: hero maxWidth: 1120 marginX: auto width: fill }
  @eyebrow { typography: label.sm color: sapphire-600 }
  @lead { typography: body.xl color: cloud-600 maxWidth: prose }
  @section { flow: vertical gap: md }
  @subsection { flow: vertical gap: sm }
  @codeBlock { flow: vertical gap: xs typography: mono.md surface: code color: cloud-100 corner: lg inset: lg overflow: auto }
  @table { flow: vertical gap: none border: subtle corner: lg overflow: hidden }
  @tableHeader { flow: horizontal gap: md inset: md surface: sapphire-50 typography: label.sm color: sapphire-900 }
  @tableRow { flow: horizontal gap: md inset: md borderTop: subtle typography: body.sm }
  @propertyName { typography: mono.sm color: sapphire-700 minWidth: 14rem }
  @propertyValue { typography: mono.sm color: cloud-700 minWidth: 12rem }
  @propertyDescription { typography: body.sm color: cloud-600 width: fill }
  @list { flow: vertical gap: sm }
  @bullet { typography: body.md color: cloud-700 }
  @callout { flow: vertical gap: sm inset: lg surface: sapphire-50 border: sapphire-200 corner: lg }
  @cards { flow: grid columns: 2 minColumn: 260 gap: md }
  @card { flow: vertical gap: sm inset: lg surface: raised border: subtle corner: lg }
  @cardTitle { typography: heading.md color: sapphire-700 }
  @meta { typography: body.sm color: cloud-500 }
  @chipRow { flow: horizontal gap: sm wrap: true }
  @chip { typography: mono.sm surface: sapphire-50 color: sapphire-800 border: sapphire-200 corner: pill inset: badge }
#end view
