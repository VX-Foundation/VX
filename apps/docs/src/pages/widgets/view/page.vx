#view
  View @page {
    Text("WIDGET REFERENCE") @eyebrow
    Title("View")
    Text("View is a layout widget lowered consistently to <div> in client and SSR output.") @lead
    View @section {
      Title("Contract summary") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Field") @propertyName
          Text("Value") @propertyDescription
        }
        View @tableRow {
          Text("Category") @propertyName
          Text("layout") @propertyDescription
        }
        View @tableRow {
          Text("Native element") @propertyName
          Text("<div>") @propertyDescription
        }
        View @tableRow {
          Text("Call property") @propertyName
          Text("none") @propertyDescription
        }
        View @tableRow {
          Text("Semantic groups") @propertyName
          Text("container") @propertyDescription
        }
        View @tableRow {
          Text("Runtime defaults") @propertyName
          Text("none") @propertyDescription
        }
      }
    }
    View @section {
      Title("Properties") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Property") @propertyName
          Text("Type / default") @propertyValue
          Text("Requirement") @propertyDescription
        }
        View @tableRow {
          Text("layout") @propertyName
          Text("Optional<String> = \"column\"") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("align") @propertyName
          Text("Optional<String> = \"stretch\"") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("justify") @propertyName
          Text("Optional<String> = \"start\"") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("spacing") @propertyName
          Text("Optional<Int> = 0") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("wrap") @propertyName
          Text("Optional<Bool> = false") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("width") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("height") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("minWidth") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("minHeight") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
