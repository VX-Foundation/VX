#view
  View @page {
    Text("WIDGET REFERENCE") @eyebrow
    Title("Video")
    Text("Video is a media widget lowered consistently to <video> in client and SSR output.") @lead
    View @section {
      Title("Contract summary") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Field") @propertyName
          Text("Value") @propertyDescription
        }
        View @tableRow {
          Text("Category") @propertyName
          Text("media") @propertyDescription
        }
        View @tableRow {
          Text("Native element") @propertyName
          Text("<video>") @propertyDescription
        }
        View @tableRow {
          Text("Call property") @propertyName
          Text("none") @propertyDescription
        }
        View @tableRow {
          Text("Semantic groups") @propertyName
          Text("media, interactive") @propertyDescription
        }
        View @tableRow {
          Text("Runtime defaults") @propertyName
          Text("none") @propertyDescription
        }
      }
    }
    View @section {
      Title("Properties") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Property") @propertyName
          Text("Type / default") @propertyValue
          Text("Requirement") @propertyDescription
        }
        View @tableRow {
          Text("src") @propertyName
          Text("String") @propertyValue
          Text("required") @propertyDescription
        }
        View @tableRow {
          Text("poster") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("autoPlay") @propertyName
          Text("Optional<Bool> = false") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("controls") @propertyName
          Text("Optional<Bool> = true") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("loop") @propertyName
          Text("Optional<Bool> = false") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("muted") @propertyName
          Text("Optional<Bool> = false") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("playsInline") @propertyName
          Text("Optional<Bool> = true") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("preload") @propertyName
          Text("Optional<String> = \"metadata\"") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("width") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("height") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("objectFit") @propertyName
          Text("Optional<String> = \"cover\"") @propertyValue
          Text("optional") @propertyDescription
        }
        View @tableRow {
          Text("cornerRadius") @propertyName
          Text("Optional<String>") @propertyValue
          Text("optional") @propertyDescription
        }
      }
    }
    View @section {
      Title("Events and outputs") { level: 2 }
      View @table {
        View @tableHeader {
          Text("Event") @propertyName
          Text("Payload") @propertyValue
          Text("Use") @propertyDescription
        }
        View @tableRow {
          Text("play") @propertyName
          Text("Void") @propertyValue
          Text("Bind with play => action().") @propertyDescription
        }
        View @tableRow {
          Text("pause") @propertyName
          Text("Void") @propertyValue
          Text("Bind with pause => action().") @propertyDescription
        }
        View @tableRow {
          Text("end") @propertyName
          Text("Void") @propertyValue
          Text("Bind with end => action().") @propertyDescription
        }
        View @tableRow {
          Text("timeUpdate") @propertyName
          Text("Float") @propertyValue
          Text("Bind with timeUpdate => action().") @propertyDescription
        }
        View @tableRow {
          Text("error") @propertyName
          Text("String") @propertyValue
          Text("Bind with error => action().") @propertyDescription
        }
      }
    }
    View @section {
      Title("Content regions") { level: 2 }
      Text("This widget does not project content regions.")
    }
    View @section {
      Title("Minimal usage") { level: 2 }
      View @codeBlock {
        Text("#view")
        Text("  Video {")
        Text("    src: \"/media/example.png\"")
        Text("  }")
        Text("#end view")
      }
    }
    View @section {
      Title("Accessibility") { level: 2 }
      Text("Media widgets require alternatives, captions or transcripts where applicable, user-controlled playback, and explicit trust boundaries for embeds.")
      View @list {
        Text("• Provide a meaningful accessible name.") @bullet
        Text("• Verify keyboard-only operation and visible focus.") @bullet
        Text("• Test invalid, disabled, loading, and empty states where supported.") @bullet
      }
    }
    View @section {
      Title("SSR, hydration, and performance") { level: 2 }
      Text("Declare intrinsic dimensions, choose suitable preload behavior, and avoid hydrating media controls unless interaction requires it.")
      View @list {
        Text("• Keep property values deterministic between server and client.") @bullet
        Text("• Avoid unnecessary client hydration for static output.") @bullet
        Text("• Dispose event, observer, timer, and subscription ownership when the widget leaves the tree.") @bullet
      }
    }
    View @section {
      Title("Best practices") { level: 2 }
      View @list {
        Text("• Prefer Video over recreating its contract through an untyped wrapper.") @bullet
        Text("• Use Visual roles for appearance and layout instead of introducing independent widget-specific CSS maps.") @bullet
        Text("• Bind only documented properties and events; unknown inputs are compiler diagnostics.") @bullet
        Text("• Cover normal, loading, empty, error, disabled, and reduced-motion behavior when relevant.") @bullet
      }
    }
    View @section {
      Title("Related widgets") { level: 2 }
      View @cards {
        View @card {
          Link("Audio") @cardTitle { href: "/widgets/audio" }
          Text("media widget lowered to the native audio element.") @meta
        }
        View @card {
          Link("Canvas") @cardTitle { href: "/widgets/canvas" }
          Text("media widget lowered to the native canvas element.") @meta
        }
        View @card {
          Link("IFrame") @cardTitle { href: "/widgets/iframe" }
          Text("media widget lowered to the native iframe element.") @meta
        }
        View @card {
          Link("Image") @cardTitle { href: "/widgets/image" }
          Text("media widget lowered to the native img element.") @meta
        }
      }
    }
  }

  @page { flow: vertical gap: xl inset: hero maxWidth: 1120 marginX: auto width: fill }
  @eyebrow { typography: label.sm color: sapphire-600 }
  @lead { typography: body.xl color: cloud-600 maxWidth: prose }
  @section { flow: vertical gap: md }
  @subsection { flow: vertical gap: sm }
  @codeBlock { flow: vertical gap: xs typography: mono.md surface: code color: cloud-100 corner: lg inset: lg overflow: auto }
  @table { flow: vertical gap: none border: subtle corner: lg overflow: hidden }
  @tableHeader { flow: horizontal gap: md inset: md surface: sapphire-50 typography: label.sm color: sapphire-900 }
  @tableRow { flow: horizontal gap: md inset: md borderTop: subtle typography: body.sm }
  @propertyName { typography: mono.sm color: sapphire-700 minWidth: 14rem }
  @propertyValue { typography: mono.sm color: cloud-700 minWidth: 12rem }
  @propertyDescription { typography: body.sm color: cloud-600 width: fill }
  @list { flow: vertical gap: sm }
  @bullet { typography: body.md color: cloud-700 }
  @callout { flow: vertical gap: sm inset: lg surface: sapphire-50 border: sapphire-200 corner: lg }
  @cards { flow: grid columns: 2 minColumn: 260 gap: md }
  @card { flow: vertical gap: sm inset: lg surface: raised border: subtle corner: lg }
  @cardTitle { typography: heading.md color: sapphire-700 }
  @meta { typography: body.sm color: cloud-500 }
  @chipRow { flow: horizontal gap: sm wrap: true }
  @chip { typography: mono.sm surface: sapphire-50 color: sapphire-800 border: sapphire-200 corner: pill inset: badge }
#end view
