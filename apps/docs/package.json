{
  "name": "@vx-foundation/docs",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "docs:generate": "node scripts/generate-portal.mjs",
    "docs:check": "node scripts/check-generated-portal.mjs && node scripts/verify-docs.mjs",
    "dev": "vx dev",
    "build": "vx build",
    "preview": "vx preview",
    "check": "vx check src",
    "lint": "vx lint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm docs:check && vx test:component src/pages/index.vx",
    "verify": "pnpm docs:check && pnpm check && pnpm lint && pnpm test && pnpm build",
    "verify:pipeline": "node scripts/verify-pipeline.mjs",
    "verify:examples": "node scripts/verify-examples.mjs"
  },
  "dependencies": {
    "@vx-foundation/core": "workspace:*",
    "@vx-foundation/router": "workspace:*",
    "@vx-foundation/runtime": "workspace:*",
    "@vx-foundation/server": "workspace:*"
  },
  "devDependencies": {
    "@vx-foundation/cli": "workspace:*",
    "@vx-foundation/tooling": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "description": "Official practical documentation application for VX 0.2.0"
}
