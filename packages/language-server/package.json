{
  "name": "@vx-foundation/language-server",
  "version": "0.1.1",
  "private": true,
  "description": "Language Server for the VX framework",
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "@vx-foundation/language": "workspace:*",
    "@vx-foundation/compiler": "workspace:*",
    "@vx-foundation/tooling": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^24.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  }
}
