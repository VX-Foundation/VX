{
  "name": "@vx-foundation/bundler",
  "version": "0.1.1",
  "description": "VX deterministic asset pipeline, multi-target build system, and official deployment adapters",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assets": {
      "import": "./dist/assets/index.js",
      "types": "./dist/assets/index.d.ts"
    },
    "./build": {
      "import": "./dist/build/index.js",
      "types": "./dist/build/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vx-foundation/compiler": "workspace:*",
    "@vx-foundation/language": "workspace:*",
    "@vx-foundation/router": "workspace:*",
    "@vx-foundation/shared": "workspace:*",
    "@vx-foundation/types": "workspace:*",
    "@vx-foundation/tooling": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "Veelv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git",
    "directory": "packages/bundler"
  },
  "homepage": "https://github.com/VX-Foundation/vx/tree/main/packages/bundler#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "keywords": [
    "vx",
    "web-framework",
    "typescript",
    "bundler"
  ]
}
