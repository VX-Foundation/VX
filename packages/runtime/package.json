{
  "name": "@vx-foundation/runtime",
  "version": "0.2.0",
  "type": "module",
  "description": "VX direct-DOM client runtime and request-scoped SSR server platform.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@vx-foundation/shared": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "author": {
    "name": "Veelv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/VX-Foundation/vx/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "keywords": [
    "vx",
    "web-framework",
    "typescript",
    "runtime"
  ]
}
