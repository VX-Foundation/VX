{
  "name": "@vx-foundation/data",
  "version": "0.1.2",
  "type": "module",
  "description": "VX query persistence, offline mutations, infinite data, realtime subscriptions, and cross-context synchronization.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./offline": {
      "types": "./dist/offline.d.ts",
      "import": "./dist/offline.js"
    },
    "./infinite": {
      "types": "./dist/infinite.d.ts",
      "import": "./dist/infinite.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast.d.ts",
      "import": "./dist/broadcast.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "import": "./dist/hub.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "dependencies": {
    "@vx-foundation/runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "author": {
    "name": "Veelv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/VX-Foundation/vx/tree/main/packages/data#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "keywords": [
    "vx",
    "web-framework",
    "typescript",
    "data"
  ]
}
