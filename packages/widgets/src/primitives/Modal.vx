#script
  prop open: Bool = false
  prop title: String = ""
  prop closeable: Bool = true
  prop class: String = ""

  output onClose: Void
  content default: optional

  action close() {
    emit("onClose")
  }
#end script

#view
  if open {
    View @modalBackdrop {
      View @modalCard {
        View @modalHeader {
          Title(title) @modalTitle
          if closeable {
            Button("✕") @closeButton {
              click => close()
            }
          }
        }
        View @modalBody {
          Content(default)
        }
      }
    }
  }

  @modalBackdrop {
    flow: vertical
    items: center
    content: center
    surface: rock-950
    inset: xl
    z: overlay
  }

  @modalCard {
    surface: steel-900
    border: steel-800
    corner: xl
    elevation: lg
    width: dialog
    flow: vertical
    gap: md
    inset: lg
  }

  @modalHeader {
    flow: horizontal
    content: space-between
    items: center
  }

  @modalTitle {
    tone: cloud-50
  }

  @closeButton {
    surface: transparent
    tone: cloud-400
    when hover {
      tone: cloud-50
      surface: steel-800
    }
  }

  @modalBody {
    flow: vertical
    gap: md
    tone: cloud-200
  }
#end view
