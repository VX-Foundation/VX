{
  "name": "@vx-foundation/compiler",
  "version": "0.1.2",
  "type": "module",
  "description": "Compiler core: Reactive graph, type checking, lowering.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./package": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@vx-foundation/language": "workspace:*",
    "@vx-foundation/shared": "workspace:*",
    "@vx-foundation/types": "workspace:*",
    "@vx-foundation/widgets": "workspace:*",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "node ../../scripts/noop-bench.mjs @vx-foundation/compiler"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "author": {
    "name": "Veelv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/VX-Foundation/vx/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "keywords": [
    "vx",
    "web-framework",
    "typescript",
    "compiler"
  ]
}
