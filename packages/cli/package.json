{
  "name": "@vx-foundation/cli",
  "version": "0.2.0",
  "description": "CLI for VX Framework",
  "main": "./dist/cli.js",
  "type": "module",
  "bin": {
    "vx": "./bin/vx.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vx-foundation/core": "workspace:*",
    "@vx-foundation/plugins": "workspace:*",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "@vx-foundation/tooling": "workspace:*",
    "@vx-foundation/release": "workspace:*",
    "@vx-foundation/package-system": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0 <23 || >=24.11.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "Veelv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VX-Foundation/vx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/VX-Foundation/vx/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/VX-Foundation/vx/issues"
  },
  "keywords": [
    "vx",
    "web-framework",
    "typescript",
    "cli"
  ]
}
