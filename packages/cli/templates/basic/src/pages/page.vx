#script
  state count: Int = 0
  derive doubled: Int = count * 2

  action increment() {
    count++
  }

  action decrement() {
    count--
  }

  action reset() {
    count = 0
  }
#end script

#view
  View @root {
    View @header {
      View @badge {
        Text("Compiler-First Reactive Engine") @badgeText
      }
      Image @logo {
        src: "/vx.svg"
        alt: "VX"
      }
      Text("VX Framework") @title
      Text("High-performance web architecture with direct DOM lowering and zero Virtual DOM overhead.") @subtitle
    }

    View @dashboardCard {
      View @cardHeader {
        Text("Reactive Signals Engine") @cardTitle
        Text("Real-time State Inspector") @cardBadge
      }

      View @metricsGrid {
        View @metricCard {
          Text("CURRENT COUNT") @metricLabel
          Text("{{ count }}") @metricValue
          Text("State Primitive") @metricMeta
        }
        View @metricCard {
          Text("DERIVED VALUE") @metricLabel
          Text("{{ doubled }}") @metricValueAccented
          Text("Signal Memo (2x)") @metricMeta
        }
      }

      View @controls {
        Button("− Decrement") @btnSecondary {
          click => decrement()
        }
        Button("Reset") @btnGhost {
          click => reset()
        }
        Button("+ Increment") @btnPrimary {
          click => increment()
        }
      }
    }

    View @featuresRow {
      View @featureItem {
        Text("Direct DOM") @featureTitle
        Text("No virtual diffing cost") @featureDesc
      }
      View @featureItem {
        Text("Type-Safe") @featureTitle
        Text("End-to-end contract validation") @featureDesc
      }
      View @featureItem {
        Text("Zero CSS Runtime") @featureTitle
        Text("Compiled visual roles") @featureDesc
      }
    }

    View @footer {
      Text("Powered by VX Framework · Production Ready") @footerText
    }
  }

  @root {
    flow: vertical
    items: center
    minHeight: viewport
    surface: base
    inset: xl
    gap: 2xl
  }

  @header {
    flow: vertical
    items: center
    gap: md
    textAlign: center
  }

  @badge {
    surface: highlighted
    corner: xl
    inset: control.sm
    border: subtle
  }

  @badgeText {
    typography: label.xs
    tone: strong
    letterSpacing: 0.04em
    textTransform: uppercase
  }

  @logo {
    width: 64
    height: 64
    margin: sm
  }

  @title {
    typography: display.lg
    tone: strong
    letterSpacing: -0.03em
  }

  @subtitle {
    typography: body.md
    tone: muted
    maxWidth: prose
    textAlign: center
  }

  @dashboardCard {
    flow: vertical
    gap: xl
    surface: raised
    corner: xl
    elevation: md
    border: subtle
    inset: 2xl
    minWidth: 360
    maxWidth: 640
  }

  @cardHeader {
    flow: horizontal
    content: between
    items: center
    border: subtle
    borderBottom: subtle
  }

  @cardTitle {
    typography: heading.md
    tone: strong
  }

  @cardBadge {
    typography: label.xs
    tone: muted
    surface: highlighted
    corner: sm
    inset: control.sm
  }

  @metricsGrid {
    flow: grid
    columns: 2
    gap: lg
  }

  @metricCard {
    flow: vertical
    gap: xs
    surface: base
    corner: xl
    inset: lg
    border: subtle
  }

  @metricLabel {
    typography: label.xs
    tone: muted
    letterSpacing: 0.08em
    textTransform: uppercase
  }

  @metricValue {
    typography: display.xl
    tone: strong
    transition: fast
  }

  @metricValueAccented {
    typography: display.xl
    tone: strong
    transition: fast
  }

  @metricMeta {
    typography: body.xs
    tone: muted
  }

  @controls {
    flow: horizontal
    content: center
    gap: md
    items: center
  }

  @btnPrimary {
    surface: primary
    tone: onPrimary
    corner: lg
    inset: control.md
    typography: label.md
    border: none
    cursor: pointer
    transition: fast
    minWidth: 110

    when hover {
      surface: primaryHover
      transform: lift
    }

    when pressed {
      transform: press
    }
  }

  @btnSecondary {
    surface: secondary
    tone: body
    corner: lg
    inset: control.md
    typography: label.md
    border: none
    cursor: pointer
    transition: fast
    minWidth: 110

    when hover {
      surface: secondaryHover
      transform: lift
    }

    when pressed {
      transform: press
    }
  }

  @btnGhost {
    surface: base
    tone: muted
    corner: lg
    inset: control.md
    typography: label.md
    border: subtle
    cursor: pointer
    transition: fast

    when hover {
      surface: highlighted
      tone: strong
    }

    when pressed {
      transform: press
    }
  }

  @featuresRow {
    flow: horizontal
    gap: xl
    items: center
    content: center
    wrap: wrap
  }

  @featureItem {
    flow: vertical
    gap: xs
    items: center
    textAlign: center
  }

  @featureTitle {
    typography: heading.xs
    tone: strong
  }

  @featureDesc {
    typography: body.xs
    tone: muted
  }

  @footer {
    flow: horizontal
    items: center
    marginY: auto
  }

  @footerText {
    typography: body.xs
    tone: muted
  }
#end view
