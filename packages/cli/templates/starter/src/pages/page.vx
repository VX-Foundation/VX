#script
  state count: Int = 0
  derive doubled: Int = count * 2

  action increment() {
    count++
  }
#end script

#view
  View @page {
    View @hero {
      View @badge {
        Text("Multi-Route App Shell") @badgeText
      }
      Text("Welcome to VX Starter") @heading
      Text("Full-stack web application structure featuring typed layouts, server endpoints, and fine-grained reactive signals.") @subheading
    }

    View @demoCard {
      View @demoCardHeader {
        Text("Interactive Signal Demo") @demoTitle
        Text("Live Component State") @demoStatus
      }

      View @counterDisplay {
        Text("{{ count }}") @countValue
        Text("derived memo (2x): {{ doubled }}") @countMeta
      }

      Button("Increment Signal (+1)") @btn {
        click => increment()
      }
    }

    View @featuresGrid {
      View @featureCard {
        Text("Fine-Grained DOM") @featureTitle
        Text("Direct DOM update targets without Virtual DOM reconciliation passes.") @featureBody
      }
      View @featureCard {
        Text("Layout Routing") @featureTitle
        Text("Hierarchical layout cascading with typed parameters and navigation hooks.") @featureBody
      }
      View @featureCard {
        Text("Type Safety") @featureTitle
        Text("End-to-end data contracts compiled directly from .vx source files.") @featureBody
      }
    }
  }

  @page {
    flow: vertical
    gap: 2xl
    items: center
  }

  @hero {
    flow: vertical
    items: center
    gap: md
    insetY: lg
    textAlign: center
  }

  @badge {
    surface: highlighted
    corner: xl
    inset: control.sm
    border: subtle
  }

  @badgeText {
    typography: label.xs
    tone: strong
    letterSpacing: 0.04em
    textTransform: uppercase
  }

  @heading {
    typography: display.lg
    tone: strong
    letterSpacing: -0.03em
  }

  @subheading {
    typography: body.md
    tone: muted
    maxWidth: prose
    textAlign: center
  }

  @demoCard {
    flow: vertical
    items: center
    gap: lg
    surface: raised
    corner: 2xl
    elevation: md
    border: subtle
    inset: 2xl
    minWidth: 320
    maxWidth: 520
  }

  @demoCardHeader {
    flow: horizontal
    content: between
    items: center
    width: fill
    border: subtle
    borderBottom: subtle
  }

  @demoTitle {
    typography: heading.xs
    tone: strong
  }

  @demoStatus {
    typography: label.xs
    tone: muted
  }

  @counterDisplay {
    flow: vertical
    items: center
    gap: xs
  }

  @countValue {
    typography: display.xl
    tone: strong
  }

  @countMeta {
    typography: label.md
    tone: muted
  }

  @btn {
    surface: primary
    tone: onPrimary
    corner: lg
    inset: control.md
    typography: label.md
    border: none
    cursor: pointer
    transition: fast

    when hover {
      surface: primaryHover
      transform: lift
    }

    when pressed {
      transform: press
    }
  }

  @featuresGrid {
    flow: grid
    columns: 3
    gap: lg
    width: fill
  }

  @featureCard {
    flow: vertical
    gap: sm
    surface: raised
    corner: xl
    border: subtle
    inset: lg
    elevation: sm
  }

  @featureIcon {
    typography: display.sm
  }

  @featureTitle {
    typography: heading.xs
    tone: strong
  }

  @featureBody {
    typography: body.xs
    tone: muted
  }
#end view
