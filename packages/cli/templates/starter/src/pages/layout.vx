#script
  content route: required
#end script

#view
  View @shell {
    View @nav {
      View @navBrand {
        Image @navLogo {
          src: "/vx.svg"
          alt: "VX"
        }
        Text("VX App") @navWordmark
        Text("v0.2.0") @navBadge
      }
      View @navLinks {
        Link("Home") @navLink {
          href: "/"
        }
        Link("About") @navLink {
          href: "/about"
        }
      }
    }

    View @main {
      Content(route)
    }

    View @siteFooter {
      Text("Built with VX Framework · Production Quality Engine") @siteFooterText
    }
  }

  @shell {
    flow: vertical
    minHeight: viewport
    surface: base
  }

  @nav {
    flow: horizontal
    items: center
    content: between
    insetX: xl
    insetY: md
    border: subtle
    borderBottom: subtle
    surface: raised
    elevation: sm
  }

  @navBrand {
    flow: horizontal
    items: center
    gap: sm
  }

  @navLogo {
    width: 32
    height: 32
  }

  @navWordmark {
    typography: heading.sm
    tone: strong
    letterSpacing: -0.02em
  }

  @navBadge {
    typography: label.xs
    tone: muted
    surface: highlighted
    corner: sm
    inset: control.sm
  }

  @navLinks {
    flow: horizontal
    gap: sm
    items: center
  }

  @navLink {
    typography: label.md
    tone: muted
    inset: control.sm
    corner: md
    transition: fast
    decoration: none

    when hover {
      surface: highlighted
      tone: strong
    }
  }

  @main {
    flexGrow: 1
    flow: vertical
    inset: xl
    maxWidth: 960
    marginX: auto
    width: fill
  }

  @siteFooter {
    flow: horizontal
    items: center
    content: center
    insetY: lg
    border: subtle
    borderTop: subtle
    surface: raised
  }

  @siteFooterText {
    typography: body.xs
    tone: muted
  }
#end view
